{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "halifax-parking-ban",
    "compatibility_date": "2026-02-01",
    "main": "src/worker.ts",
    "assets": {
        "directory": "./dist/client",
        "not_found_handling": "single-page-application"
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "STATUS_STORE",
                "class_name": "ParkingStatusStore"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["ParkingStatusStore"]
        }
    ],
    "triggers": {
        "crons": ["*/2 * * * *"]
    }
}
